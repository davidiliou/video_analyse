{
  "name": "video-analyse",
  "version": "0.1.0",
  "description": "Analyse vidéo rugby — tagging manuel d'événements",
  "main": "dist-electron/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "WEB_ONLY=1 vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && WEB_ONLY=1 vite build",
    "preview": "WEB_ONLY=1 vite preview --port 8087 --host",
    "server": "DATA_DIR=./data STATIC_DIR=./dist PORT=8087 node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jspdf": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
